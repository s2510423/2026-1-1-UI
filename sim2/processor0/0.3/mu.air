FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0.3";
    object      mu.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 1.8e-05;

boundaryField
{
    Inlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    Outlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    Wall
    {
        type            calculated;
        value           uniform 1.8e-05;
    }
    procBoundary0to3
    {
        type            processor;
        value           uniform 1.8e-05;
    }
}


// ************************************************************************* //
