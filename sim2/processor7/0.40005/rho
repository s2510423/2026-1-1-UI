internalField   uniform 1.2;

boundaryField
{
    Inlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    Outlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    Wall
    {
        type            calculated;
        value           uniform 1.2;
    }
    procBoundary7to4
    {
        type            processor;
        value           uniform 1.2;
    }
    procBoundary7to6
    {
        type            processor;
        value           uniform 1.2;
    }
}


