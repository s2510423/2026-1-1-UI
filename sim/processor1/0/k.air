FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      k.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.01;

boundaryField
{
    Inlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    Outlet
    {
        type            zeroGradient;
    }
    Wall
    {
        type            zeroGradient;
    }
    procBoundary1to0
    {
        type            processor;
        value           uniform 0.01;
    }
    procBoundary1to3
    {
        type            processor;
        value           uniform 0.01;
    }
}


// ************************************************************************* //
