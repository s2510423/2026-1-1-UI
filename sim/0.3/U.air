boundaryField
{
    Wall
    {
        type            noSlip;
    }
    Inlet
    {
        type            fixedValue;
        value           uniform (4 0 0);
    }
    Outlet
    {
        type            zeroGradient;
    }
    Empty
    {
        type            empty;
    }
}


