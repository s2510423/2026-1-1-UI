FoamFile { version 2.0; format ascii; class dictionary; location "system"; object fvSolution; }

solvers
{
    "p.*"
    {
        solver          PCG;
        preconditioner  diagonal;
        tolerance       1e-6;
        relTol          0.05;
    }
    "(U|k|omega).*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.1;
    }
}

PIMPLE
{
    nOuterCorrectors     2;
    nCorrectors          2;
    nNonOrthogonalCorrectors 5; // 3에서 5로 더 늘려! (비직교성 끝판왕 대응)
}

relaxationFactors
{
    fields
    {
        "p.*"           0.05; // 0.1도 높다. 0.05로 더 죽여버려.
    }
    equations
    {
        "U.*"           0.2; // 속도도 더 꽉 눌러.
        "k.*"           0.2;
        "omega.*"       0.2;
    }
}
