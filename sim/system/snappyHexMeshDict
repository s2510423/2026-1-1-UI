FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 1. 최상단 마스터 스위치 (이전 버전에서 누락되었던 파츠 보완)
castellatedMesh true;
snap            false;
addLayers       false;

// 2. 글로벌 파라미터 및 디버그 플래그
mergeTolerance 1e-6;
debug 0;

geometry
{
    Inlet.stl  { type triSurfaceMesh; name Inlet; }
    Outlet.stl { type triSurfaceMesh; name Outlet; }
    Wall.stl   { type triSurfaceMesh; name Wall; }
}

castellatedMeshControls
{
    maxLocalCells 100000;
    maxGlobalCells 2000000;
    minRefinementCells 10;
    nCellsBetweenLevels 3;

    features
    (
        { file "Wall.eMesh"; level 3; }
        { file "Inlet.eMesh"; level 2; }
        { file "Outlet.eMesh"; level 2; }
    );

    refinementSurfaces
    {
        Inlet  { level (2 2); }
        Outlet { level (2 2); }
        Wall   { level (2 3); } 
    }

    resolveFeatureAngle 30;

    // 🌟 이번 에러의 범인 검거! 빈 통이라도 규격상 반드시 있어야 합니다.
    refinementRegions
    {
    }

    locationInMesh (0.01 0.01 0.01); 

    allowFreeStandingZoneFaces false;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 30;
    nRelaxIter 5;
}

addLayersControls
{
    relativeSizes true;
    layers {}
    expansionRatio 1.0;
    finalLayerThickness 0.3;
    minThickness 0.1;
    nGrow 0;
}

meshQualityControls
{
    maxNonOrtho 55;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minFlatness 0.5;
    minVol 1e-13;
    minTetQuality 1e-30;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.02;
    minVolRatio 0.01;
    nSmoothScale 4;
    errorReduction 0.75;
    minTriangleTwist -1;        
    minVolXYZ            1e-13;
    minFlatnessXYZ       0.5;
}

// 3. 최하단 병렬 연산용 필수 컴포넌트 껍데기 추가
mergeFacesControls
{
    mergeTolerance 1e-6;
    mergePlanarFaces false;
}

