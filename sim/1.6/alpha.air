FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "1.6";
    object      alpha.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    Wall
    {
        type            calculated;
        value           uniform 1;
    }
    Inlet
    {
        type            calculated;
        value           uniform 1;
    }
    Outlet
    {
        type            calculated;
        value           uniform 1;
    }
    Empty
    {
        type            empty;
    }
}


// ************************************************************************* //
